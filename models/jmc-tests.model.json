{
  "#": "JSON Model for JMC Test Vectors",
  "~": "https://json-model.org/models/json-model",
  "$": {
    "": "https://json-model.org/models/jmc-tests",
    "Comment": "/./",
    "Expect": { "|": [ true, null ] },
    "Test2": [ "$Expect", "$ANY" ],
    "Test3": [ "$Expect", "/^[-\\w]*$/", "$ANY" ],
    "Test": {
      "|": [ "$Comment", "$Test2", "$Test3" ]
    }
  },
  "@": [ "$Test" ]
}
