{
  "#": "JSON Schema Draft 03 as a diff from Draft 02",
  "~": "https://json-model.org/models/json-model",
  "%": {
    "<": "$https://json-model.org/models/json-schema-draft-02",
    "$#": {
      "/": "distinctStringArray",
      "*": {
        "distinctSchemaArray": { "@": [ {"|": ["", "$Schema"]} ], "!": true }
      }
    },
    "$Schema": {
      "/": [ "?requires", "?contentEncoding" ],
      "*": {
        "?patternProperties": {"": "$Schema"},
        "?additionalItems": {"|": [true, "$Schema"]},
        "?dependencies": {"": {"|": ["", [""], "$Schema"]}},
        "?$ref": ""
      },
      "~": {
        "?optional": "?required",
        "?minimumCanEqual": "?exclusiveMinimum",
        "?maximumCanEqual": "?exclusiveMaximum"
      }
    },
    "$Schema.?disallow.|": {
      "/": [ "$distinctStringArray" ],
      "*": [ "$distinctSchemaArray" ]
    },
    "$Schema.?format": {
      "|": ["date-time", "date", "time", "utc-millisec", "regex", "color", "style", "phone", "uri", "email", "ip-address", "ipv6", "host-name"]
    }
  },
  "@": "$Schema"
}
