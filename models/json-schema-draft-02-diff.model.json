{
  "#": "JSON Schema Draft 02 as a diff from Draft 01",
  "~": "https://json-model.org/models/json-model",
  "$": {
    "": "https://json-model.org/models/json-schema-draft-02-diff",
    "schema": "$https://json-model.org/models/json-schema-draft-01"
  },
  "%": {
    "$schema#disStrArray": { "@": [""], "!": true },
    "$schema.?disallow.|": {
      "/": [ [""] ],
      "*": [ "$disStrArray" ]
    },
    "$schema.?enum": {
      "*": { "!": true }
    },
    "$schema": {
      "/": "?maxDecimal",
      "*": {
        "?divisibleBy": 1.0,
        "?uniqueItems": true
      }
    }
  },
  "@": "$schema"
}
