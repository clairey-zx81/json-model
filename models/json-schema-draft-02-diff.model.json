{
  "#": "JSON Schema Draft 02 as a diff from Draft 01",
  "~": "https://json-model.org/models/json-model",
  "%": {
    "<": "$https://json-model.org/models/json-schema-draft-01",
    "$distinctStringArray": { "@": [""], "!": true },
    "$Schema.?disallow.|": {
      "/": [ [""] ],
      "*": [ "$distinctStringArray" ]
    },
    "$Schema.?enum": {
      "*": { "!": true }
    },
    "$Schema": {
      "/": "?maxDecimal",
      "*": {
        "?divisibleBy": 1.0,
        "?uniqueItems": true
      }
    }
  },
  "@": "$Schema"
}
