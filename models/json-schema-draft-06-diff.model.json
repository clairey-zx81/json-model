{
  "#": "JSON Schema Draft 06 as a diff from Draft 04",
  "~": "https://json-model.org/modes/json-model",
  "%": {
    "<": "$https://json-model.org/models/json-schema-draft-04",
    "$stringArray": { "/": [ ">=", "!" ] },
    "$typeArray": { "/": "!" },
    "$ObjectSchema": {
      "/": [
        "?exclusiveMinimum", "?exclusiveMaximum", "?additionalItems",
        "?additionalProperties", "?patternProperties", "?$ref", "?$schema"
      ],
      "*": {
        "#.n": "4 new properties",
        "?examples": [ "$ANY" ],
        "?contains": "$Schema",
        "?propertyNames": "$Schema",
        "?const": "$ANY",
        "#.r": "property replacements",
        "?exclusiveMinimum": -1.0,
        "?exclusiveMaximum": -1.0,
        "?additionalItems": "$Schema",
        "?additionalProperties": "$Schema",
        "?patternProperties": {"$REGEX": "$Schema"},
        "?$ref": "",
        "?$schema": "$URI"
      },
      ":": { "?id": "?$id" }
    }
  },
  "@": "$Schema"
}
