{
  "#": "JSON Model for JSTS tests",
  "#.doc": "JSON Schema Test Suite tests file format",
  "#.url": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/tree/main/tests",
  "~": "https://json-model.org/models/json-model",
  "$": {
    "": "https://json-model.org/models/test-schema",
    "Section": "/^[0-9]+(\\.[0-9]+)*$/",
    "Test": {
      "#": "A single test",
      "description": "",
      "?comment": "",
      "data": "$ANY",
      "valid": true
    },
    "Specification": {
      "@": {
        "?core": { "|": [ "$SEMVER", "$Section" ] },
        "?validation": "$SEMVER",
        "?ecma262": "$SEMVER",
        "?perl5": "",
        "?quote": "",
        "/^rfc\\d+$/": "$SEMVER",
        "/^iso\\d+$/": "$SEMVER"
      },
      ">": 0
    },
    "TestCase": {
      "description": "",
      "?comment": "",
      "schema": "$ANY",
      "tests": {
        "@": [ "$Test" ],
        ">": 0
      },
      "?specification": {
        "@": [ "$Specification" ],
        ">": 0,
        "!": true
      }
    }
  },
  "@": [ "$TestCase" ],
  ">": 0
}
