{
  "#": "JSON Model for JSTS tests",
  "#.doc": "JSON Schema Test Suite tests file format (November 2026)",
  "#.url": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/tree/main/validation/tests",
  "#.schema": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/main/validation/validation-test-schema.json",
  "~": "https://json-model.org/models/json-model",
  "$": {
    "": "https://json-model.org/models/test-schema",
    "Compatibility": "/^(<?=)?([123467]|2019|2020|9999)(,(<?=)?([123467]|2019|2020|9999))*$/",
    "Section": "/^[0-9]+(\\.[0-9]+)*$/",
    "Test": {
      "#": "A single test",
      "description": "",
      "?comment": "",
      "data": "$ANY",
      "valid": true
    },
    "Tag": { "|": [ "_format-annotation", "_format-assertion" ] },
    "Specification": {
      "@": {
        "?core": { "|": [ "$SEMVER", "$Section" ] },
        "?validation": "$SEMVER",
        "?ecma262": "$SEMVER",
        "?perl5": "",
        "?quote": "",
        "/^rfc\\d+$/": { "|": [ "$SEMVER", "$Section" ] },
        "/^iso\\d+$/": "$SEMVER"
      },
      ">": 0
    },
    "TestCase": {
      "_description": "",
      "?compatibility": "$Compatibility",
      "?comment": "",
      "?tags": [ "$Tag" ],
      "_schema": "$ANY",
      "?externalSchemas": { "$URL": "$ANY" },
      "_tests": {
        "@": [ "$Test" ],
        ">": 0
      },
      "?specification": {
        "@": [ "$Specification" ],
        ">": 0,
        "!": true
      }
    }
  },
  "@": {
    "_$schema": "",
    "_description": "",
    "_tests": [  "$TestCase" ]
  }
}
