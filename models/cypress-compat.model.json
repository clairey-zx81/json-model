{
  "#": "JSON model for Cypress Configuration (official schema compatible)",
  "#.doc": "Test runners configuration file format for [Cypress](https://cypress.io/)",
  "#.ref": "https://docs.cypress.io/app/references/configuration",
  "#.note": "JSON configuration format, which seems now to be .js or .ts",
  "#.todo": "switch to a transformation of the root schema",
  "~": "https://json-model.org/models/json-model",
  "$": {
    "cypressConfig": {
      "#.baseUrl": "this should be a $URL",
      "?baseUrl": "",
      "#.env": "should the value be restricted to strings?",
      "?env": { "": "$ANY" },
      "?ignoreTestFiles": { "|": [ "", [""] ] },
      "?numTestsKeptInMemory": 0,
      "?port": 1,
      "#.reporter": "predefined list of js file",
      "?reporter": "",
      "?reporterOptions": { "": "$ANY" },
      "?slowTestThreshold": 1,
      "?testFiles": { "|": [ "", [""] ] },
      "?watchForFileChanges": true,
      "?defaultCommandTimeout": 1,
      "?execTimeout": 1,
      "?taskTimeout": 1,
      "?pageLoadTimeout": 1,
      "?requestTimeout": 1,
      "?responseTimeout": 1,
      "?fileServerFolder": "",
      "?fixtureFolder": {"|": ["", "=false"]},
      "?integrationFolder": "",
      "?downloadsFolder": "",
      "?componentFolder": {"|": ["", "=false"]},
      "?pluginsFile": {"|": ["", "=false"]},
      "?screenshotOnRunFailure": true,
      "?screenshotsFolder": "",
      "?supportFile": {"|": ["", "=false"]},
      "?videoFolder": "",
      "?trashAssetsBeforeRuns": true,
      "?videoCompression": {"|": [0, "=false"]},
      "?video": true,
      "?videoUploadOnPasses": true,
      "?chromeWebSecurity": true,
      "?userAgent": "",
      "?blockHosts": { "|": [ "", [""] ] },
      "?modifyObstructiveCode": true,
      "?viewportHeight": 1,
      "?viewportWidth": 1,
      "?animationDistanceThreshold": 1,
      "?waitForAnimations": true,
      "?scrollBehavior": { "|": [ "=false", "center", "top", "bottom", "nearest" ] },
      "?projectId": "",
      "?nodeVersion": { "|": [ "system", "bundled" ] },
      "?experimentalInteractiveRunEvents": true,
      "?experimentalSourceRewriting": true,
      "?experimentalSessionRewriting": true,
      "?experimentalFetchPolyfill": true,
      "?experimentalStudio": true,
      "?retries": {
        "|": [
          null,
          0,
          { "": "$ANY" }
        ]
      },
      "?includeShadowDom": true,
      "?clientCertificates": [
        {
          "url": "$URL",
          "?ca": [ "" ],
          "certs": {
            "|": [
              { "cert": "", "key": "", "?passphrase": "", "": "$ANY" },
              { "pfx": "", "?passphrase": "", "": "$ANY" }
            ]
          }
        }
      ],
      "": "$ANY"
    }
  },
  "+": [
    "$cypressConfig",
    { "?component": "$cypressConfig", "?e2e": "$cypressConfig" }
  ]
}
