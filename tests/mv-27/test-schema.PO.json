{
  "@": [
    "$TestCase"
  ],
  ">=": 1,
  "#": "JsonModel 1",
  "$": {
    "Section": "/^[0-9]+(\\.[0-9]+)*$/",
    "Test": {
      "description": "",
      "?comment": "",
      "data": "$ANY",
      "valid": true,
      "#": "JsonModel 3"
    },
    "Specification": {
      "@": {
        "?core": {
          "|": [
            "$SEMVER",
            "$Section"
          ]
        },
        "?validation": "$SEMVER",
        "?ecma262": "$SEMVER",
        "?perl5": "",
        "?quote": "",
        "/^rfc\\d+$/": "$SEMVER",
        "/^iso\\d+$/": "$SEMVER"
      },
      ">=": 1,
      "#": "JsonModel 4"
    },
    "TestCase": {
      "description": "",
      "?comment": "",
      "schema": "$ANY",
      "tests": {
        "@": [
          "$Test"
        ],
        ">=": 1
      },
      "?specification": {
        "@": [
          "$Specification"
        ],
        "!": true,
        ">=": 1
      },
      "#": "JsonModel 5"
    },
    "#": "Symbol 1",
    "": "https://json-model.org/models/test-schema"
  },
  "~": "https://json-model.org/models/json-model"
}
