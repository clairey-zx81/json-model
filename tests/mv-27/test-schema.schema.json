{
  "$comment": "JSON Schema generated by JSON Model Compiler",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Compatibility": {
      "type": "string",
      "pattern": "^(<?=)?([123467]|2019|2020|9999)(,(<?=)?([123467]|2019|2020|9999))*$"
    },
    "Section": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)*$"
    },
    "Test": {
      "description": "A single test",
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "data": true,
        "valid": {
          "type": "boolean"
        }
      },
      "required": [
        "description",
        "data",
        "valid"
      ],
      "additionalProperties": false
    },
    "Tag": {
      "enum": [
        "format-annotation",
        "format-assertion"
      ]
    },
    "Specification": {
      "type": "object",
      "patternProperties": {
        "^rfc\\d+$": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([0-9]|[1-9][0-9]+)\\.([0-9]|[1-9][0-9]+)\\.([0-9]|[1-9][0-9]+)(-(([0-9]|[1-9][0-9]+)|[-0-9a-zA-Z]*[-a-zA-Z][-0-9a-zA-Z]*)(\\.(([0-9]|[1-9][0-9]+)|[-0-9a-zA-Z]*[-a-zA-Z][-0-9a-zA-Z]*))*)?(\\+(([0-9]|[1-9][0-9]+)|[-0-9a-zA-Z]*[-a-zA-Z][-0-9a-zA-Z]*)(\\.(([0-9]|[1-9][0-9]+)|[-0-9a-zA-Z]*[-a-zA-Z][-0-9a-zA-Z]*))*)?$"
            },
            {
              "$ref": "#/$defs/Section"
            }
          ]
        },
        "^iso\\d+$": {
          "type": "string",
          "pattern": "^([0-9]|[1-9][0-9]+)\\.([0-9]|[1-9][0-9]+)\\.([0-9]|[1-9][0-9]+)(-(([0-9]|[1-9][0-9]+)|[-0-9a-zA-Z]*[-a-zA-Z][-0-9a-zA-Z]*)(\\.(([0-9]|[1-9][0-9]+)|[-0-9a-zA-Z]*[-a-zA-Z][-0-9a-zA-Z]*))*)?(\\+(([0-9]|[1-9][0-9]+)|[-0-9a-zA-Z]*[-a-zA-Z][-0-9a-zA-Z]*)(\\.(([0-9]|[1-9][0-9]+)|[-0-9a-zA-Z]*[-a-zA-Z][-0-9a-zA-Z]*))*)?$"
        }
      },
      "properties": {
        "core": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([0-9]|[1-9][0-9]+)\\.([0-9]|[1-9][0-9]+)\\.([0-9]|[1-9][0-9]+)(-(([0-9]|[1-9][0-9]+)|[-0-9a-zA-Z]*[-a-zA-Z][-0-9a-zA-Z]*)(\\.(([0-9]|[1-9][0-9]+)|[-0-9a-zA-Z]*[-a-zA-Z][-0-9a-zA-Z]*))*)?(\\+(([0-9]|[1-9][0-9]+)|[-0-9a-zA-Z]*[-a-zA-Z][-0-9a-zA-Z]*)(\\.(([0-9]|[1-9][0-9]+)|[-0-9a-zA-Z]*[-a-zA-Z][-0-9a-zA-Z]*))*)?$"
            },
            {
              "$ref": "#/$defs/Section"
            }
          ]
        },
        "validation": {
          "type": "string",
          "pattern": "^([0-9]|[1-9][0-9]+)\\.([0-9]|[1-9][0-9]+)\\.([0-9]|[1-9][0-9]+)(-(([0-9]|[1-9][0-9]+)|[-0-9a-zA-Z]*[-a-zA-Z][-0-9a-zA-Z]*)(\\.(([0-9]|[1-9][0-9]+)|[-0-9a-zA-Z]*[-a-zA-Z][-0-9a-zA-Z]*))*)?(\\+(([0-9]|[1-9][0-9]+)|[-0-9a-zA-Z]*[-a-zA-Z][-0-9a-zA-Z]*)(\\.(([0-9]|[1-9][0-9]+)|[-0-9a-zA-Z]*[-a-zA-Z][-0-9a-zA-Z]*))*)?$"
        },
        "ecma262": {
          "type": "string",
          "pattern": "^([0-9]|[1-9][0-9]+)\\.([0-9]|[1-9][0-9]+)\\.([0-9]|[1-9][0-9]+)(-(([0-9]|[1-9][0-9]+)|[-0-9a-zA-Z]*[-a-zA-Z][-0-9a-zA-Z]*)(\\.(([0-9]|[1-9][0-9]+)|[-0-9a-zA-Z]*[-a-zA-Z][-0-9a-zA-Z]*))*)?(\\+(([0-9]|[1-9][0-9]+)|[-0-9a-zA-Z]*[-a-zA-Z][-0-9a-zA-Z]*)(\\.(([0-9]|[1-9][0-9]+)|[-0-9a-zA-Z]*[-a-zA-Z][-0-9a-zA-Z]*))*)?$"
        },
        "perl5": {
          "type": "string"
        },
        "quote": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "TestCase": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "compatibility": {
          "$ref": "#/$defs/Compatibility"
        },
        "comment": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Tag"
          }
        },
        "schema": true,
        "externalSchemas": {
          "type": "object",
          "patternProperties": {
            "^((https?|s?ftp|rtsps?|s3|cm|oci|amqp)://([\\w.-]+(:[^@\\s]*@)?([-\\w.]*|\\[[a-fA-F0-9:.]+\\])(:\\d+)?)?(/[^/?#\\s]*)*(\\?[^#\\s]*)?(#\\S*)?|file:([^?#\\s:/<>{}()!=*]+)?(/[^?#\\s/]*)*(\\?[^#\\s]*)?(#\\S*)?|(ssh|telnet|mailto):([-+!#$%&'`*/=?^{}|~_a-z0-9]+)(\\.([-+!#$%&'`*/=?^{}|~_a-z0-9]+))*@([a-z0-9][-a-z0-9]{0,62})(\\.([a-z0-9][-a-z0-9]{0,62}))*|urn:[\\w.:-]+)$": true
          },
          "additionalProperties": false
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Test"
          },
          "minItems": 1
        },
        "specification": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Specification"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "description",
        "schema",
        "tests"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TestCase"
      }
    }
  },
  "required": [
    "$schema",
    "description",
    "tests"
  ],
  "additionalProperties": false
}
