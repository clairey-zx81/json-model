{
  "$comment": "JSON Schema generated by JSON Model Compiler",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "JSON-RPC 2.0 Protocol",
  "$defs": {
    "Id": {
      "description": "Request/response identifier: null, integer, or string",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "Notification": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "type": "string",
          "pattern": "."
        },
        "params": {
          "anyOf": [
            {
              "type": "array",
              "items": true
            },
            {
              "type": "object",
              "additionalProperties": true
            }
          ]
        }
      },
      "required": [
        "jsonrpc",
        "method"
      ],
      "additionalProperties": false
    },
    "Request": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "type": "string",
          "pattern": "."
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "params": {
          "anyOf": [
            {
              "type": "array",
              "items": true
            },
            {
              "type": "object",
              "additionalProperties": true
            }
          ]
        }
      },
      "required": [
        "jsonrpc",
        "method",
        "id"
      ],
      "additionalProperties": false
    },
    "BatchRequest": {
      "description": "One or more client messages sent together",
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/Request"
          },
          {
            "$ref": "#/$defs/Notification"
          }
        ]
      },
      "minItems": 1
    },
    "ClientMessage": {
      "anyOf": [
        {
          "$ref": "#/$defs/Notification"
        },
        {
          "$ref": "#/$defs/Request"
        },
        {
          "$ref": "#/$defs/BatchRequest"
        }
      ]
    },
    "Response": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "result": true
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "integer"
            },
            "message": {
              "type": "string"
            },
            "data": true
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "additionalProperties": false
    },
    "BatchResponse": {
      "description": "One or more responses returned for a batch (notifications omitted)",
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/Response"
          },
          {
            "$ref": "#/$defs/Error"
          }
        ]
      },
      "minItems": 1
    },
    "ServerMessage": {
      "anyOf": [
        {
          "$ref": "#/$defs/Response"
        },
        {
          "$ref": "#/$defs/Error"
        },
        {
          "$ref": "#/$defs/BatchResponse"
        }
      ]
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/ClientMessage"
    },
    {
      "$ref": "#/$defs/ServerMessage"
    }
  ]
}
